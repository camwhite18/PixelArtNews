# Copy to .env on the server and fill in. Never commit .env.

# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: route Claude calls through Cloudflare AI Gateway for logs, caching
# and a spend cap, e.g.
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
ANTHROPIC_BASE_URL=

# Token for a Cloudflare Tunnel whose public hostname points at http://server:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: a free key from https://www.football-data.org/client/register puts
# the real Premier League table on the FOOTBALL studio board. Without it the
# board stays decorative. (F1 standings and the weather need no key.)
FOOTBALL_DATA_KEY=

# Optional overrides
# MODEL_MAIN=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# PIPELINE_INTERVAL=1h
# SCHEDULE_HORIZON=3h
# TTS_CPUS=3
# WEATHER_CHANNEL=world        # which channel gets the breakfast weather
# FOOTBALL_COMPETITION=PL      # football-data.org competition code
# BOARDS_TTL=3h                # how often studio boards refresh
