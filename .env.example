# Copy to .env on the server and fill in. Never commit .env.

# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: route Claude calls through Cloudflare AI Gateway for logs, caching
# and a spend cap, e.g.
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
ANTHROPIC_BASE_URL=

# Token for a Cloudflare Tunnel whose public hostname points at http://server:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Optional overrides
# MODEL_MAIN=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# PIPELINE_INTERVAL=1h
# SCHEDULE_HORIZON=3h
# TTS_CPUS=3
